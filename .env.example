# Backend API URL (for production, set to your deployed backend URL)
VITE_API_URL=http://localhost:8080

# Google Analytics 4 Measurement ID (starts with G-).
# Optional: while this is unset, Google Analytics is not loaded at all and the
# consent banner is hidden. Create a property at analytics.google.com, copy the
# Measurement ID, and add it to Vercel's Environment Variables to activate it.
VITE_GA_ID=
